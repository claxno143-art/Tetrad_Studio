{
  "name": "tetrad-studio",
  "productName": "Tetrad Studio",
  "version": "1.5.0",
  "description": "Tetrad Studio: Russian Reader, List Trainer and OPI Memory Tool",
  "author": "Tetrad Studio",
  "license": "UNLICENSED",
  "main": "main.js",
  "build": {
    "appId": "io.github.russianstudy.tetradstudio",
    "productName": "Tetrad Studio",
    "copyright": "Content credits are listed in the Reader settings",
    "files": [
      "main.js",
      "app/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tetrad Studio",
      "artifactName": "Tetrad-Studio-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": null,
      "artifactName": "Tetrad-Studio-${version}-mac-${arch}.${ext}"
    },
    "afterPack": "./afterPack.js",
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  }
}